# NEAR Value Intelligence — Environment Variables
# Copy to .env and fill in values. NEVER commit .env

# NEAR Intents Explorer API (partners.near-intents.org)
# Rate limit: 1 request / 5 seconds per partner
NEAR_INTENTS_JWT=

# Google Cloud / BigQuery
# Service account with BigQuery access to bigquery-public-data.crypto_near_mainnet_us
GOOGLE_APPLICATION_CREDENTIALS=.gcp/bigquery-credentials.json
GCP_PROJECT_ID=near-514618
# Cost guard: max bytes billed per query (default 100 GB)
BQ_MAX_BYTES_BILLED=100000000000

# Intents backfill window (days)
BACKFILL_DAYS=90

# NearBlocks API (fallback for revenue wallets if BigQuery unavailable)
NEARBLOCKS_API_KEY=

# Data mode: live | snapshot | synthetic
DATA_MODE=live
PIKESPEAK_API_KEY=
