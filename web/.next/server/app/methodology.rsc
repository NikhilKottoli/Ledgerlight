11:["$","section",null,{"className":"bg-neutral-900/50 border border-neutral-700 rounded-xl p-4","children":[["$","h2",null,{"className":"text-lg font-semibold mb-4","children":"Known Limitations"}],["$","ul",null,{"className":"space-y-2 text-sm text-muted","children":[["$","li",null,{"children":["• ",["$","strong",null,{"children":"Accounts ≠ humans:"}]," \"Active accounts\" = distinct signer addresses. Multi-sig, exchanges, bots inflate counts."]}],["$","li",null,{"children":["• ",["$","strong",null,{"children":"Addresses ≠ people:"}]," Multi-chain individuals = multiple addresses. \"Unique sender addresses\" used, never \"people\"."]}],["$","li",null,{"children":["• ",["$","strong",null,{"children":"Confidential flows:"}]," Intents CONFIDENTIAL_INTENTS deposit/recipient types not fully visible."]}],["$","li",null,{"children":["• ",["$","strong",null,{"children":"Explorer coverage:"}]," 1Click API documents only its own coverage; other integrators may differ."]}],["$","li",null,{"children":["• ",["$","strong",null,{"children":"Price conversion:"}]," NEAR↔USD conversion introduces noise; revenue in NEAR is primary."]}],["$","li",null,{"children":["• ",["$","strong",null,{"children":"Timing mismatch:"}]," Fees accrue per swap; sweeps to protocol wallets happen later with variable lag."]}],["$","li",null,{"children":["• ",["$","strong",null,{"children":"Buyback ≠ burned:"}]," Onchain evidence shows bought-back NEAR held, not burned. Revenue.near.org claims \"permanently removed\"."]}],["$","li",null,{"children":["• ",["$","strong",null,{"children":"BigQuery quota:"}]," Free tier 1 TB/month limits backfill; revenue wallet outflows pending quota reset."]}]]}]]}]
